# ntquant environment template — copy to .env and fill in secrets.
# Used by python-dotenv; keys prefixed NTA_ override YAML config.
#
# Example overrides (YAML <- env):
#   NTA_STRATEGY__FAST_PERIOD=15
#   NTA_DATA__COUNT=5000
#   NTA_DATA__SOURCE=binance

# Provider / adapter secrets (placeholder for future live/data integrations)
NTA_API_KEY=
NTA_API_SECRET=

# Keyed data providers (Polygon / Alpha Vantage / Databento) — empty placeholders
NTA_POLYGON_API_KEY=
NTA_ALPHAVANTAGE_API_KEY=
NTA_DATABENTO_API_KEY=
